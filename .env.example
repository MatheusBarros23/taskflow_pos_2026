# Copie para .env (que nao e versionado) e troque todos os valores.
# Gere valores com: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use apenas letras e numeros nas senhas: elas entram na DATABASE_URL.

TASKFLOW_SECRET_KEY=troque-me
TASKFLOW_ADMIN_PASSWORD=troque-me

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=taskflow

WEB_PORT=8000
